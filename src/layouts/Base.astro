---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  windowTitle?: string;
  type?: string;
}

const { title, description, windowTitle, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const hasWindow = Boolean(windowTitle);
const path = Astro.url.pathname;

const dockApps = [
  { href: '/', label: 'Home', icon: '/dock-home.png', active: path === '/' },
  { href: '/blog/', label: 'Blog', icon: '/dock-notes.webp', active: path.startsWith('/blog') },
  { href: '/projects/', label: 'Projects', icon: '/dock-xcode.webp', active: path.startsWith('/projects') },
  { href: '/videos/', label: 'YouTube', icon: '/dock-youtube.webp', active: path.startsWith('/videos') },
];

const dockLinks = [
  { href: 'https://voiceprompter.app', label: 'VoicePrompter', icon: '/voiceprompter-icon.png' },
  { href: 'https://github.com/kosuvorov', label: 'GitHub', icon: '/dock-github.webp' },
  { href: 'https://www.instagram.com/kosuvorov/', label: 'Instagram', icon: '/dock-instagram.webp' },
  { href: 'mailto:hey@konsu.dev', label: 'Email me', icon: '/dock-mail.webp' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Konstantin Suvorov" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Google+Sans+Flex:opsz,wght,ROND@8..144,300..800,100&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Konstantin Suvorov" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
    </script>
    <slot name="head" />
  </head>
  <body>
    <!-- Liquid-glass refraction filter (Chromium renders it; others keep frosted blur) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="liquid-lens" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.008 0.014" numOctaves="2" seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="18" xChannelSelector="R" yChannelSelector="G" />
        <feGaussianBlur stdDeviation="1.2" />
      </filter>
    </svg>

    <header class="menubar" aria-label="Menu bar">
      <div class="menubar-left">
        <a class="menubar-name" href="/">Konstantin Suvorov</a>
      </div>
      <div class="menubar-right">
        <span class="menubar-battery" aria-label="Battery full" title="Fully charged, unlike me">
          <svg viewBox="0 0 28 14" width="26" height="13" aria-hidden="true"><rect x="1" y="1" width="22" height="12" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.6" opacity="0.55"/><rect x="3" y="3" width="18" height="8" rx="2" fill="currentColor"/><path d="M25 4.6v4.8c1.4-.3 2.3-1.2 2.3-2.4S26.4 4.9 25 4.6Z" fill="currentColor" opacity="0.55"/></svg>
        </span>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor"><path d="M20.6 14.6A8.7 8.7 0 0 1 9.4 3.4a8.7 8.7 0 1 0 11.2 11.2Z"/></svg>
        </button>
        <span class="menubar-clock" id="menubar-clock"></span>
      </div>
    </header>

    <div class="desktop">
      {hasWindow ? (
        <section class="window" id="window">
          <div class="window-titlebar" id="window-titlebar">
            <span class="traffic-lights">
              <a class="light red" href="/" aria-label="Close window"></a>
              <a class="light yellow" href="/" aria-label="Minimize (go to desktop)"></a>
              <button class="light green" id="window-zoom" aria-label="Maximize window"></button>
            </span>
            <span class="window-title">{windowTitle}</span>
            <span class="traffic-spacer" aria-hidden="true"></span>
          </div>
          <div class="window-content">
            <main>
              <slot />
            </main>
            <footer class="window-footer">
              <span>© {new Date().getFullYear()} Konstantin Suvorov</span>
              <span class="links">
                <a href="https://www.youtube.com/@kosuvorov" rel="me">YouTube</a>
                <a href="https://www.instagram.com/kosuvorov/" rel="me">Instagram</a>
                <a href="mailto:hey@konsu.dev">Email</a>
                <a href="/rss.xml">RSS</a>
              </span>
            </footer>
          </div>
          <span class="window-resize nw" data-dir="nw" aria-hidden="true"></span>
          <span class="window-resize ne" data-dir="ne" aria-hidden="true"></span>
          <span class="window-resize sw" data-dir="sw" aria-hidden="true"></span>
          <span class="window-resize se" data-dir="se" aria-hidden="true"></span>
        </section>
      ) : (
        <main class="desktop-content">
          <slot />
        </main>
      )}
    </div>

    <nav class="dock" aria-label="Main">
      <div class="dock-liquid" aria-hidden="true"></div>
      {dockApps.map((app) => (
        <a href={app.href} class={`dock-item${app.active ? ' active' : ''}`} data-label={app.label}>
          <img class="dock-icon" src={app.icon} alt="" width="52" height="52" />
        </a>
      ))}
      <span class="dock-divider" aria-hidden="true"></span>
      {dockLinks.map((link) => (
        <a href={link.href} class="dock-item" data-label={link.label} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
          <img class="dock-icon" src={link.icon} alt="" width="52" height="52" />
        </a>
      ))}
    </nav>

    <script is:inline>
      // Clock - "Jul 6  09:41"
      (function () {
        const el = document.getElementById('menubar-clock');
        function tick() {
          const d = new Date();
          el.textContent =
            d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) +
            '  ' +
            d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
        }
        tick();
        setInterval(tick, 20000);
      })();

      // Theme toggle with crossfade (View Transitions where supported)
      (function () {
        const btn = document.getElementById('theme-toggle');
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        const current = () => document.documentElement.dataset.theme || (mq.matches ? 'dark' : 'light');
        const apply = () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        };
        btn.addEventListener('click', () => {
          if (document.startViewTransition) {
            document.startViewTransition(apply);
          } else {
            apply();
          }
        });
      })();

      // Window: maximize, drag by titlebar, resize from any corner (fine pointers)
      (function () {
        const win = document.getElementById('window');
        if (!win) return;
        document.getElementById('window-zoom').addEventListener('click', () => {
          win.classList.toggle('maximized');
          win.style.transform = '';
          win.style.width = '';
          win.style.height = '';
          ox = 0; oy = 0;
        });
        if (!window.matchMedia('(pointer: fine)').matches) return;

        let ox = 0, oy = 0;
        const bar = document.getElementById('window-titlebar');
        let sx = 0, sy = 0, dragging = false;
        bar.addEventListener('pointerdown', (e) => {
          if (e.target.closest('.light')) return;
          dragging = true;
          sx = e.clientX - ox;
          sy = e.clientY - oy;
          bar.setPointerCapture(e.pointerId);
        });
        bar.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          ox = e.clientX - sx;
          oy = e.clientY - sy;
          win.style.transform = `translate(${ox}px, ${oy}px)`;
        });
        const stopDrag = () => { dragging = false; };
        bar.addEventListener('pointerup', stopDrag);
        bar.addEventListener('pointercancel', stopDrag);

        document.querySelectorAll('.window-resize').forEach((handle) => {
          const dir = handle.dataset.dir;
          let rw = 0, rh = 0, rx = 0, ry = 0, box = 0, boy = 0, resizing = false;
          handle.addEventListener('pointerdown', (e) => {
            resizing = true;
            const rect = win.getBoundingClientRect();
            rw = rect.width;
            rh = rect.height;
            rx = e.clientX;
            ry = e.clientY;
            box = ox;
            boy = oy;
            win.classList.remove('maximized');
            handle.setPointerCapture(e.pointerId);
            e.preventDefault();
          });
          handle.addEventListener('pointermove', (e) => {
            if (!resizing) return;
            const dx = e.clientX - rx;
            const dy = e.clientY - ry;
            const east = dir.includes('e');
            const south = dir.includes('s');
            const newW = Math.max(340, east ? rw + dx : rw - dx);
            const newH = Math.max(260, south ? rh + dy : rh - dy);
            win.style.width = newW + 'px';
            win.style.height = newH + 'px';
            // resizing from a left/top edge keeps the opposite edge anchored
            ox = box + (east ? 0 : (rw - newW) / 2) - (east ? (rw - newW) / 2 : 0);
            oy = boy + (south ? 0 : (rh - newH) / 2) - (south ? (rh - newH) / 2 : 0);
            win.style.transform = `translate(${ox}px, ${oy}px)`;
          });
          const stopResize = () => { resizing = false; };
          handle.addEventListener('pointerup', stopResize);
          handle.addEventListener('pointercancel', stopResize);
        });
      })();
    </script>
  </body>
</html>
