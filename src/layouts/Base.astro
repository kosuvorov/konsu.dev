---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  windowTitle?: string;
  type?: string;
  noPad?: boolean;
}

const { title, description, windowTitle, type = 'website', noPad = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const hasWindow = Boolean(windowTitle);
const path = Astro.url.pathname;

const dockApps = [
  { href: '/', label: 'Home', icon: '/dock-home.png', active: path === '/' },
  { href: '/blog/', label: 'Blog', icon: '/dock-notes.webp', active: path.startsWith('/blog') },
  { href: '/projects/', label: 'Projects', icon: '/dock-projects.webp', active: path.startsWith('/projects') },
  { href: '/videos/', label: 'YouTube', icon: '/dock-youtube.webp', active: path.startsWith('/videos') },
];

const dockLinks = [
  { href: 'https://voiceprompter.app', label: 'VoicePrompter', icon: '/voiceprompter-icon.png' },
];

const ev = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const contactLinks = [
  { href: 'https://github.com/kosuvorov', label: 'GitHub', icon: '/dock-github.webp' },
  { href: 'https://linkedin.com/in/kosuvorov', label: 'LinkedIn', icon: '/dock-linkedin.webp' },
  { href: 'https://www.instagram.com/kosuvorov/', label: 'Instagram', icon: '/dock-instagram.webp' },
  { href: 'mailto:hey@konsu.dev', label: 'Email', icon: '/dock-mail.webp' },
  { href: 'https://t.me/kosuvorov', label: 'Telegram', icon: '/dock-telegram.webp' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Konstantin Suvorov" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Pacifico&family=Google+Sans+Flex:opsz,wght,ROND@8..144,300..800,100&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Konstantin Suvorov" />
    <meta property="og:image" content="https://konsu.dev/clouds-day.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Umami Analytics -->
    <script defer src="https://reactive-analytics.up.railway.app/script.js" data-website-id="22e45a1a-843e-4210-86f2-3c9da9cec4f4"></script>
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const mode = saved === 'light' || saved === 'dark' ? saved : 'auto';
      document.documentElement.dataset.themeMode = mode;
      if (mode !== 'auto') document.documentElement.dataset.theme = mode;
    </script>
    <slot name="head" />
  </head>
  <body>
    <!-- Liquid-glass refraction filter -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="liquid-lens" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.008 0.014" numOctaves="2" seed="7" result="noise"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="18" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
        <feGaussianBlur stdDeviation="1.2"></feGaussianBlur>
      </filter>
    </svg>

    <header class="menubar" aria-label="Menu bar">
      <div class="menubar-left">
        <a class="menubar-name" href="/" data-umami-event="menubar-name">Konstantin Suvorov</a>
      </div>
      <div class="menubar-right">
        <span class="menubar-battery" aria-label="Battery full" title="Fully charged, unlike me">
          <svg viewBox="0 0 28 14" width="26" height="13" aria-hidden="true"
            ><rect x="1" y="1" width="22" height="12" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.6" opacity="0.55"
            ></rect><rect x="3" y="3" width="18" height="8" rx="2" fill="currentColor"></rect><path
              d="M25 4.6v4.8c1.4-.3 2.3-1.2 2.3-2.4S26.4 4.9 25 4.6Z"
              fill="currentColor"
              opacity="0.55"></path></svg
          >
        </span>
        <button class="theme-toggle" id="theme-toggle" aria-label="Theme: auto. Click to change" title="Theme: auto" data-umami-event="theme-toggle">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            ><circle cx="12" cy="12" r="4.5"></circle><path
              d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19"></path></svg
          >
          <svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor"
            ><path d="M20.6 14.6A8.7 8.7 0 0 1 9.4 3.4a8.7 8.7 0 1 0 11.2 11.2Z"></path></svg
          >
          <svg class="icon-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17" stroke-width="1.6"></path><path
              d="M12 3.5a8.5 8.5 0 0 1 0 17"
              fill="currentColor"
              stroke="none"></path></svg
          >
        </button>
        <span class="menubar-clock" id="menubar-clock"></span>
      </div>
    </header>

    <div class="desktop">
      <div class="desktop-icons-grid left">
        {dockLinks.map((link) => (
          <a class="desktop-icon" href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined} data-umami-event={`desktop-${ev(link.label)}`}>
            <img class="desktop-icon-img" src={link.icon} alt={link.label} width="52" height="52" />
          </a>
        ))}
      </div>
      <div class="desktop-icons-grid right">
        {contactLinks.map((link) => (
          <a class="desktop-icon" href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined} data-umami-event={`desktop-${ev(link.label)}`}>
            <img class="desktop-icon-img" src={link.icon} alt={link.label} width="52" height="52" />
          </a>
        ))}
      </div>
      {hasWindow ? (
        <section class={`window${windowTitle === 'Blog' ? ' window-blog' : ''}`} id="window">
          <div class="window-titlebar" id="window-titlebar">
            <span class="traffic-lights">
              <a class="light red" href="/" aria-label="Close window" data-umami-event="window-close"></a>
              <a class="light yellow" href="/" aria-label="Minimize (go to desktop)" data-umami-event="window-minimize"></a>
              <button class="light green" id="window-zoom" aria-label="Maximize window" data-umami-event="window-zoom"></button>
            </span>
            <span class="window-title">{windowTitle}</span>
            <span class="traffic-spacer" aria-hidden="true"></span>
          </div>
          <div class={`window-content${noPad ? ' no-pad' : ''}`}>
            <main>
              <slot />
            </main>
            {!noPad && (
              <footer class="window-footer">
                <span>© {new Date().getFullYear()} Konstantin Suvorov</span>
                <span class="links">
                  <a href="https://www.youtube.com/@kosuvorov" rel="me" data-umami-event="footer-youtube">YouTube</a>
                  <a href="https://www.instagram.com/kosuvorov/" rel="me" data-umami-event="footer-instagram">Instagram</a>
                  <a href="mailto:hey@konsu.dev" data-umami-event="footer-email">Email</a>
                  <a href="/rss.xml" data-umami-event="footer-rss">RSS</a>
                </span>
              </footer>
            )}
          </div>
          <span class="window-resize nw" data-dir="nw" aria-hidden="true"></span>
          <span class="window-resize ne" data-dir="ne" aria-hidden="true"></span>
          <span class="window-resize sw" data-dir="sw" aria-hidden="true"></span>
          <span class="window-resize se" data-dir="se" aria-hidden="true"></span>
        </section>
      ) : (
        <main class="desktop-content">
          <slot />
        </main>
      )}
    </div>

    <nav class="dock" aria-label="Main">
      <div class="dock-liquid" aria-hidden="true"></div>
      {dockApps.map((app) => (
        <a href={app.href} class={`dock-item${app.active ? ' active' : ''}`} data-label={app.label} data-umami-event={`dock-${ev(app.label)}`}>
          <img class={`dock-icon${app.pad ? ' scale-up' : ''}`} src={app.icon} alt="" width="52" height="52" />
        </a>
      ))}

    </nav>

    <script is:inline>
      // Clock - "Jul 6  09:41"
      (function () {
        const el = document.getElementById('menubar-clock');
        function tick() {
          const d = new Date();
          el.textContent =
            d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) +
            '  ' +
            d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
        }
        tick();
        setInterval(tick, 20000);
      })();

      // Theme: auto -> dark -> light -> auto, crossfaded via View Transitions
      (function () {
        const btn = document.getElementById('theme-toggle');
        const order = { auto: 'dark', dark: 'light', light: 'auto' };
        const apply = () => {
          const next = order[document.documentElement.dataset.themeMode || 'auto'];
          document.documentElement.dataset.themeMode = next;
          if (next === 'auto') {
            delete document.documentElement.dataset.theme;
            localStorage.removeItem('theme');
          } else {
            document.documentElement.dataset.theme = next;
            localStorage.setItem('theme', next);
          }
          btn.title = 'Theme: ' + next;
          btn.setAttribute('aria-label', 'Theme: ' + next + '. Click to change');
        };
        btn.addEventListener('click', () => {
          if (document.startViewTransition) {
            document.startViewTransition(apply);
          } else {
            apply();
          }
        });
      })();

      // Window: maximize, drag by titlebar, resize from any corner (fine pointers)
      (function () {
        const win = document.getElementById('window');
        if (!win) return;
        let ox = 0, oy = 0;
        document.getElementById('window-zoom').addEventListener('click', () => {
          win.classList.toggle('maximized');
          win.style.transform = '';
          win.style.width = '';
          win.style.height = '';
          ox = 0; oy = 0;
        });
        if (!window.matchMedia('(pointer: fine)').matches) return;

        const bar = document.getElementById('window-titlebar');
        let sx = 0, sy = 0, dragging = false;
        bar.addEventListener('pointerdown', (e) => {
          if (e.target.closest('.light')) return;
          dragging = true;
          sx = e.clientX - ox;
          sy = e.clientY - oy;
          bar.setPointerCapture(e.pointerId);
        });
        bar.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          ox = e.clientX - sx;
          oy = e.clientY - sy;
          win.style.transform = `translate(${ox}px, ${oy}px)`;
        });
        const stopDrag = () => { dragging = false; };
        bar.addEventListener('pointerup', stopDrag);
        bar.addEventListener('pointercancel', stopDrag);

        document.querySelectorAll('.window-resize').forEach((handle) => {
          const dir = handle.dataset.dir;
          let rw = 0, rh = 0, rx = 0, ry = 0, box = 0, boy = 0, resizing = false;
          handle.addEventListener('pointerdown', (e) => {
            resizing = true;
            const rect = win.getBoundingClientRect();
            rw = rect.width;
            rh = rect.height;
            rx = e.clientX;
            ry = e.clientY;
            box = ox;
            boy = oy;
            win.classList.remove('maximized');
            handle.setPointerCapture(e.pointerId);
            e.preventDefault();
          });
          handle.addEventListener('pointermove', (e) => {
            if (!resizing) return;
            const dx = e.clientX - rx;
            const dy = e.clientY - ry;
            const east = dir.includes('e');
            const south = dir.includes('s');
            const newW = Math.max(340, east ? rw + dx : rw - dx);
            const newH = Math.max(260, south ? rh + dy : rh - dy);
            win.style.width = newW + 'px';
            win.style.height = newH + 'px';
            ox = box + (east ? (newW - rw) / 2 : (rw - newW) / 2);
            oy = boy + (south ? (newH - rh) / 2 : (rh - newH) / 2);
            win.style.transform = `translate(${ox}px, ${oy}px)`;
          });
          const stopResize = () => { resizing = false; };
          handle.addEventListener('pointerup', stopResize);
          handle.addEventListener('pointercancel', stopResize);
        });
      })();
      // Track outbound links in content that don't carry an explicit event
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href]');
        if (!a || a.dataset.umamiEvent) return;
        const href = a.getAttribute('href') || '';
        if (!/^https?:/.test(href) || href.startsWith(location.origin)) return;
        window.umami?.track('outbound-link', { url: href.slice(0, 120) });
      });
    </script>
  </body>
</html>
