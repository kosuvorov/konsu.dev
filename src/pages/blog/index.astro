---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Base
  title="Blog - Konstantin Suvorov"
  windowTitle="Notes"
  description="Notes on building products solo: VoicePrompter, speech recognition, indie development, and small tools."
  noPad
>
  <div class="notes">
    <aside class="notes-sidebar">
      <h2 class="notes-heading">All Notes</h2>
      <ul class="notes-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="notes-item">
              <strong>{post.data.title}</strong>
              <span class="notes-meta">
                <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                <span class="notes-snippet">{post.data.description.slice(0, 44)}…</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
    <section class="notes-empty" aria-hidden="true">
      <p>Select a note</p>
    </section>
  </div>
</Base>
