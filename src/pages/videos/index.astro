---
import Base from '../../layouts/Base.astro';

// Fetched at build time from the channel RSS feed - refreshes on every deploy.
const CHANNEL_ID = 'UC_w-OxYmymcfeHkOI0lhMvA';

interface Video {
  id: string;
  title: string;
  published: Date;
}

let videos: Video[] = [];
try {
  const res = await fetch(`https://www.youtube.com/feeds/videos.xml?channel_id=${CHANNEL_ID}`);
  const xml = await res.text();
  const entries = xml.split('<entry>').slice(1);
  const all = entries.map((e) => ({
    id: e.match(/<yt:videoId>([^<]+)/)?.[1] ?? '',
    title: (e.match(/<title>([^<]+)/)?.[1] ?? '').replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&#39;/g, "'"),
    published: new Date(e.match(/<published>([^<]+)/)?.[1] ?? 0),
  })).filter((v) => v.id);

  // Keep long-form only: /shorts/<id> answers 200 for Shorts and redirects for regular videos.
  const checks = await Promise.all(
    all.map(async (v) => {
      try {
        // SOCS=CAI skips the EU consent wall
        const [shortsRes, watchRes] = await Promise.all([
          fetch(`https://www.youtube.com/shorts/${v.id}`, { redirect: 'manual', headers: { cookie: 'SOCS=CAI' } }),
          fetch(`https://www.youtube.com/watch?v=${v.id}`, { headers: { cookie: 'SOCS=CAI' } })
        ]);
        const isShort = shortsRes.status === 200;
        const watchHtml = await watchRes.text();
        const isLive = watchHtml.includes('itemprop="isLiveBroadcast" content="True"');
        return !isShort && !isLive;
      } catch {
        return true; // if the check fails, keep the video
      }
    })
  );
  videos = all.filter((_, i) => checks[i]);
} catch {
  videos = [];
}

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Base
  title="Videos - Konstantin Suvorov"
  windowTitle="YouTube"
  description="Videos from Konstantin Suvorov's YouTube channel: indie development, VoicePrompter, Mac apps, and building products solo."
>
  <section class="panel">
    <h2 class="section-title" style="margin-top:18px;">
      Latest videos ·
      <a href="https://www.youtube.com/@kosuvorov" rel="me">subscribe on YouTube →</a>
    </h2>
    {videos.length > 0 ? (
      <ul class="video-grid">
        {videos.map((v) => (
          <li>
            <a class="video-card" href={`https://www.youtube.com/watch?v=${v.id}`}>
              <img
                src={`https://i.ytimg.com/vi/${v.id}/hq720.jpg`}
                onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${v.id}/mqdefault.jpg'`}
                alt=""
                loading="lazy"
                width="640"
                height="360"
              />
              <span class="video-meta">
                <h3>{v.title}</h3>
                <time datetime={v.published.toISOString()}>{fmt(v.published)}</time>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p>Couldn't load videos right now - find them all on <a href="https://www.youtube.com/@kosuvorov">my channel</a>.</p>
    )}
  </section>
</Base>
