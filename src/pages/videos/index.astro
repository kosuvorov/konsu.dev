---
import Base from '../../layouts/Base.astro';

// Fetched at build time from the channel RSS feed - refreshes on every deploy.
const CHANNEL_ID = 'UC_w-OxYmymcfeHkOI0lhMvA';

interface Video {
  id: string;
  title: string;
  published: string;
}

let videos: Video[] = [];
try {
  const res = await fetch(`https://www.youtube.com/channel/${CHANNEL_ID}/videos`, {
    headers: { cookie: 'SOCS=CAI', 'accept-language': 'en-US,en;q=0.9' },
  });
  const html = await res.text();
  const match = html.match(/ytInitialData = (\{.*?\});<\/script>/);
  if (match) {
    const data = JSON.parse(match[1]);
    const tabs = data.contents.twoColumnBrowseResultsRenderer.tabs;
    const videosTab = tabs.find((t: any) => t.tabRenderer?.endpoint?.commandMetadata?.webCommandMetadata?.url?.endsWith('/videos'));
    
    if (videosTab) {
      const items = videosTab.tabRenderer.content.richGridRenderer.contents;
      videos = items
        .filter((i: any) => i.richItemRenderer?.content?.lockupViewModel)
        .map((i: any) => {
          const v = i.richItemRenderer.content.lockupViewModel;
          return {
            id: v.contentId,
            title: v.metadata.lockupMetadataViewModel.title.content,
            published: v.metadata.lockupMetadataViewModel.metadata.contentMetadataViewModel.metadataRows[0].metadataParts[1].text.content,
          };
        });
    }
  }
} catch {
  videos = [];
}
---

<Base
  title="Videos - Konstantin Suvorov"
  windowTitle="YouTube"
  description="Videos from Konstantin Suvorov's YouTube channel: indie development, VoicePrompter, Mac apps, and building products solo."
>
  <section class="panel">
    <h2 class="section-title" style="margin-top:18px;">
      Latest videos ·
      <a href="https://www.youtube.com/@kosuvorov" rel="me">subscribe on YouTube →</a>
    </h2>
    {videos.length > 0 ? (
      <ul class="video-grid">
        {videos.map((v) => (
          <li>
            <a class="video-card" href={`https://www.youtube.com/watch?v=${v.id}`} data-umami-event="video-open" data-umami-event-title={v.title}>
              <img
                src={`https://i.ytimg.com/vi/${v.id}/hq720.jpg`}
                onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${v.id}/mqdefault.jpg'`}
                alt=""
                loading="lazy"
                width="640"
                height="360"
              />
              <span class="video-meta">
                <h3>{v.title}</h3>
                <time>{v.published}</time>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p>Couldn't load videos right now - find them all on <a href="https://www.youtube.com/@kosuvorov">my channel</a>.</p>
    )}
  </section>
</Base>
