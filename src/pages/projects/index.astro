---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Projects - Konstantin Suvorov"
  windowTitle="Projects"
  description="Things Konstantin Suvorov has built: VoicePrompter, LinkedIn Connections Graph, and other small tools for creators."
>
  <section class="panel">
    <h2 class="section-title" style="margin-top:18px;">Projects</h2>
    <ul class="card-list">
      <li>
        <a class="card" href="https://voiceprompter.app">
          <h3>VoicePrompter</h3>
          <p>
            A voice-controlled teleprompter for Mac, iPhone, iPad, and the web. Tracks
            your speech against the whole script and stays invisible during screen
            sharing.
          </p>
        </a>
      </li>
      <li>
        <a class="card" href="https://kosuvorov.github.io/linkedin-connections-graph/">
          <h3>LinkedIn Connections Graph</h3>
          <p>
            Turn your LinkedIn export into an Obsidian-style force graph - grouped by
            company, role, or year. Runs 100% in your browser.
          </p>
        </a>
      </li>
      <li>
        <a class="card" href="https://github.com/kosuvorov">
          <h3>More on GitHub</h3>
          <p>Experiments, utilities, and whatever I'm currently poking at.</p>
        </a>
      </li>
    </ul>
  </section>
</Base>
