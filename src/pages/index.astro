---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Base
  title="Konstantin Suvorov - maker of VoicePrompter"
  description="Personal site of Konstantin Suvorov: indie developer building VoicePrompter and other small, useful tools. Writing about building products solo."
>
  <section class="hero">
    <h1>Hey, I'm Konstantin.</h1>
    <p>
      I'm an indie developer. I build small, useful tools - most notably
      <a href="https://voiceprompter.app">VoicePrompter</a>, a teleprompter that
      scrolls as you speak, used by creators in 125+ countries. Here I write about
      what I build and what I learn building it.
    </p>
  </section>

  <h2 class="section-title" id="projects">Projects</h2>
  <ul class="card-list">
    <li>
      <a class="card" href="https://voiceprompter.app">
        <h3>VoicePrompter</h3>
        <p>
          A voice-controlled teleprompter for Mac, iPhone, iPad, and the web. Tracks
          your speech against the whole script and stays invisible during screen
          sharing.
        </p>
      </a>
    </li>
    <li>
      <a class="card" href="https://kosuvorov.github.io/linkedin-connections-graph/">
        <h3>LinkedIn Connections Graph</h3>
        <p>
          Turn your LinkedIn export into an Obsidian-style force graph - grouped by
          company, role, or year. Runs 100% in your browser.
        </p>
      </a>
    </li>
    <li>
      <a class="card" href="https://github.com/kosuvorov">
        <h3>More on GitHub</h3>
        <p>Experiments, utilities, and whatever I'm currently poking at.</p>
      </a>
    </li>
  </ul>

  <h2 class="section-title">Writing</h2>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
      </li>
    ))}
  </ul>
</Base>
